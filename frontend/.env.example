# ===== Conexão com o backend =====
# URL da API REST (backend Express + Prisma)
VITE_API_URL=http://localhost:3000
# URL do mock local (JSON Server)
VITE_MOCK_API_URL=http://localhost:3001
# true: usa o mock local; false: usa a API real
VITE_USE_MOCK=true

# URL base para imagens do Cloudinary
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/furniro/image/upload